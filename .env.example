# Copy this file to `.env` and adjust. Values here are used only if the variable
# isn't already set in the real environment (systemd/Docker settings override .env).

# Site title — shown in the page <title> and the header.
SITE_TITLE=Matt Blank

# Directory to index and serve. Sub-directories become albums.
PHOTO_ROOT=./photos

# Public base URL, e.g. https://photos.example.com. When set, the app emits
# canonical + Open Graph tags so shared photo links (?photo=…) get a preview
# (title + the image itself). Leave empty if you don't have a domain.
SITE_DOMAIN=

# Address/port to listen on.
ADDR=:8080

# Path to the persisted index cache (speeds up restarts). Empty disables it.
GALLERY_CACHE=gallery-cache.gob

# How often to rescan for added/removed photos (Go duration; 0 disables).
GALLERY_REFRESH=2m
