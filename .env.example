# Copy this file to `.env` and adjust. Values here are used only if the variable
# isn't already set in the real environment (systemd/Docker settings override .env).
#
# Every setting the app reads can be set here EXCEPT GALLERY_ENV_FILE: that one
# points at this file, so it's read before the file is loaded and must be a real
# environment variable (default: .env). Example: GALLERY_ENV_FILE=/etc/photo-gallery.env

# ── Site ─────────────────────────────────────────────────────────────────────

# Site title — shown in the page <title> and the header.
SITE_TITLE=My Photo Gallery

# Directory to index and serve. Sub-directories become albums.
PHOTO_ROOT=./photos

# Public base URL, e.g. https://photos.example.com. When set, the app emits
# canonical + Open Graph tags so shared photo links (?photo=…) get a preview
# (title + the image itself). Leave empty if you don't have a domain.
SITE_DOMAIN=

# Address/port to listen on.
ADDR=:8080

# ── Indexing & caching ───────────────────────────────────────────────────────

# Path to the persisted index cache (speeds up restarts). Empty disables it.
GALLERY_CACHE=gallery-cache.gob

# Directory for generated thumbnails and previews (the grid/filmstrip and viewer
# serve these instead of full-size originals). Empty generates them on the fly.
THUMB_CACHE=gallery-thumbs

# Pre-generate all thumbnails/previews in the background after indexing so the first
# browse is instant. Costs CPU + disk up front. Off by default (generated on demand).
WARM_CACHE=false

# How often to rescan for added/removed photos (Go duration; 0 disables).
GALLERY_REFRESH=2m

# ── Image sizes ──────────────────────────────────────────────────────────────

# Thumbnail (grid + filmstrip): max height in px, and JPEG/WebP quality (1-100).
THUMB_HEIGHT=512
THUMB_QUALITY=82

# Preview (fullscreen viewer image): max longest edge in px, and quality (1-100).
# Larger = sharper but heavier; the full original is still available via download.
PREVIEW_MAX=2048
PREVIEW_QUALITY=85

# Download resolution presets offered in the per-photo download menu, as a
# comma-separated list of "label:WIDTHxHEIGHT" (bounding box; never upscaled).
# "Original" is always offered in addition to these.
DOWNLOAD_SIZES=720p:1280x720,1080p:1920x1080,1440p:2560x1440,4k:3840x2160
